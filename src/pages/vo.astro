---
import BaseLayout from '../components/layout/BaseLayout.astro';
import VOHero from '../components/vo/VOHero.astro';
import MediaCatalog from '../components/vo/MediaCatalog.astro';
import WhyMohamed from '../components/vo/WhyMohamed.astro';
import CredentialsSection from '../components/sections/CredentialsSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<BaseLayout 
  locale="ar" 
  currentTrack="vo"
  title="محمد القلشاني — مؤدي صوتي محترف | Voice Over Artist"
  description="معلق صوتي محترف بإحساس يفهم السياق ويخاطب الجمهور ويخدم الهدف البيعي. إعلانات، تمثيل، وثائقي، وكتب صوتية بجودة استوديو معزول وتسليم سريع."
>
  <!-- VO Hero with Master Showreel -->
  <VOHero locale="ar" />

  <!-- Categorized Filterable Media Grid with Custom Speed & Wave Audio/Video Players -->
  <MediaCatalog locale="ar" />

  <!-- Why Work with Mohamed VO -->
  <WhyMohamed locale="ar" />

  <!-- Credentials & Training -->
  <CredentialsSection locale="ar" />

  <!-- Direct Contact & Project Inquiry -->
  <ContactSection locale="ar" />
</BaseLayout>
