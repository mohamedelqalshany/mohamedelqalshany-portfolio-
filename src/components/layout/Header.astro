---
import { getT } from '../../lib/i18n.js';
import ThemeToggle from '../common/ThemeToggle.astro';

interface Props {
  locale?: 'ar' | 'en';
  currentTrack?: 'gateway' | 'vo' | 'marketing';
}

const { locale = 'ar', currentTrack = 'gateway' } = Astro.props;
const t = getT(locale);
const isAr = locale === 'ar';

const voHref = isAr ? '/vo' : '/en/vo';
const mktHref = isAr ? '/marketing' : '/en/marketing';
const gatewayHref = isAr ? '/' : '/en';

// Alternative language href
let altLangHref = isAr ? '/en' : '/';
if (currentTrack === 'vo') {
  altLangHref = isAr ? '/en/vo' : '/vo';
} else if (currentTrack === 'marketing') {
  altLangHref = isAr ? '/en/marketing' : '/marketing';
}
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <!-- Brand Mark -->
    <a href={gatewayHref} class="brand" aria-label={t.siteName}>
      <span class="brand__monogram" aria-hidden="true">MQ</span>
      <div class="brand__text">
        <span class="brand__name">{t.siteName}</span>
        <span class="brand__subtitle">
          {currentTrack === 'vo' ? t.voiceOverTrack : currentTrack === 'marketing' ? t.marketingTrack : (isAr ? 'الصوت والتسويق' : 'Voice & Marketing')}
        </span>
      </div>
      <span class="header-live-badge" title={isAr ? "متاح لاستقبال وتسجيل المشاريع الجديدة" : "Studio active for bookings"}>
        <span class="live-pulse-dot" aria-hidden="true"></span>
        <span class="live-pulse-text">{isAr ? 'متاح للمشاريع الجديدة' : 'Available for Projects'}</span>
      </span>
    </a>

    <!-- Dual Mode Switcher (Pill Switcher) -->
    {currentTrack !== 'gateway' && (
      <div class="track-switcher" role="navigation" aria-label="Portfolio Track Switcher">
        <a 
          href={voHref} 
          class:list={['track-switcher__btn', { 'is-active': currentTrack === 'vo' }]}
          aria-current={currentTrack === 'vo' ? 'page' : undefined}
        >
          <span class="track-icon">🎙️</span>
          <span>{t.voiceOverTrack}</span>
        </a>
        <a 
          href={mktHref} 
          class:list={['track-switcher__btn', { 'is-active': currentTrack === 'marketing' }]}
          aria-current={currentTrack === 'marketing' ? 'page' : undefined}
        >
          <span class="track-icon">🎬</span>
          <span>{t.marketingTrack}</span>
        </a>
      </div>
    )}

    <!-- Navigation Links -->
    <nav class="site-nav" aria-label="Main Navigation">
      <ul class="site-nav__list">
        {currentTrack === 'gateway' ? (
          <>
            <li><a href={voHref} class="site-nav__link">🎙️ {t.voiceOverTrack}</a></li>
            <li><a href={mktHref} class="site-nav__link">🎬 {t.marketingTrack}</a></li>
          </>
        ) : currentTrack === 'vo' ? (
          <>
            <li><a href="#samples-library" class="site-nav__link">{t.navShowreel}</a></li>
            <li><a href="#why-me" class="site-nav__link">{t.navAbout}</a></li>
            <li><a href="#credentials" class="site-nav__link">{t.navCredentials}</a></li>
            <li><a href="#contact" class="site-nav__link">{t.navContact}</a></li>
          </>
        ) : (
          <>
            <li><a href="#marketing-demo" class="site-nav__link">{isAr ? 'الديمو' : 'Demo'}</a></li>
            <li><a href="#pillars" class="site-nav__link">{isAr ? 'الركائز' : 'Pillars'}</a></li>
            <li><a href="#workflow" class="site-nav__link">{t.navWorkflow}</a></li>
            <li><a href="#packages" class="site-nav__link">{t.navServices}</a></li>
            <li><a href="#contact" class="site-nav__link">{t.navContact}</a></li>
          </>
        )}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="site-header__actions">
      <!-- Language Switcher -->
      <a class="lang-switch" href={altLangHref} aria-label={isAr ? "Switch to English" : "التبديل إلى العربية"}>
        {t.langSwitch}
      </a>

      <!-- Theme Toggle -->
      <ThemeToggle locale={locale} />

      <!-- CTA Button -->
      <a href="#contact" class="btn btn--primary btn--sm header-cta">
        {t.ctaTalk}
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button class="mobile-toggle" type="button" data-mobile-toggle aria-label="Toggle Navigation Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" data-mobile-drawer hidden>
    <div class="container mobile-drawer__inner">
      {currentTrack !== 'gateway' && (
        <div class="mobile-track-switcher">
          <a href={voHref} class:list={['mobile-track-btn', { 'is-active': currentTrack === 'vo' }]}>
            🎙️ {t.voiceOverTrack}
          </a>
          <a href={mktHref} class:list={['mobile-track-btn', { 'is-active': currentTrack === 'marketing' }]}>
            🎬 {t.marketingTrack}
          </a>
        </div>
      )}

      <ul class="mobile-nav__list">
        {currentTrack === 'gateway' ? (
          <>
            <li><a href={voHref} class="mobile-nav__link">🎙️ {t.voiceOverTrack}</a></li>
            <li><a href={mktHref} class="mobile-nav__link">🎬 {t.marketingTrack}</a></li>
          </>
        ) : currentTrack === 'vo' ? (
          <>
            <li><a href="#samples-library" class="mobile-nav__link">{t.navShowreel}</a></li>
            <li><a href="#why-me" class="mobile-nav__link">{t.navAbout}</a></li>
            <li><a href="#credentials" class="mobile-nav__link">{t.navCredentials}</a></li>
            <li><a href="#contact" class="mobile-nav__link">{t.navContact}</a></li>
          </>
        ) : (
          <>
            <li><a href="#marketing-demo" class="mobile-nav__link">{isAr ? 'الديمو' : 'Demo'}</a></li>
            <li><a href="#pillars" class="mobile-nav__link">{isAr ? 'الركائز' : 'Pillars'}</a></li>
            <li><a href="#workflow" class="mobile-nav__link">{t.navWorkflow}</a></li>
            <li><a href="#packages" class="mobile-nav__link">{t.navServices}</a></li>
            <li><a href="#contact" class="mobile-nav__link">{t.navContact}</a></li>
          </>
        )}
        <li><a href={gatewayHref} class="mobile-nav__link">{t.gatewayIntro}</a></li>
      </ul>

      <div class="mobile-drawer__footer">
        <a href="#contact" class="btn btn--primary btn--lg w-full">
          {t.ctaTalk}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--surface-trans);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1.5rem;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand__monogram {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background-color: var(--brand-primary);
    color: #FAEDCD;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    box-shadow: var(--shadow-sm);
  }

  html[data-theme='dark'] .brand__monogram {
    background-color: #1A3426;
    color: var(--secondary);
    border: 1px solid rgba(244, 162, 97, 0.3);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
  }

  .brand__name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }

  .brand__subtitle {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
  }

  .header-live-badge {
    display: none;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--brand-primary);
    background-color: rgba(30, 58, 43, 0.08);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(30, 58, 43, 0.18);
    margin-inline-start: 0.5rem;
  }

  @media (min-width: 900px) {
    .header-live-badge {
      display: inline-flex;
    }
  }

  html[data-theme='dark'] .header-live-badge {
    color: var(--secondary);
    background-color: rgba(244, 162, 97, 0.12);
    border-color: rgba(244, 162, 97, 0.25);
  }

  .live-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #2a9d8f;
    box-shadow: 0 0 6px #2a9d8f;
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { transform: scale(0.9); opacity: 0.5; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  /* Track Switcher (Pill) */
  .track-switcher {
    display: none;
    align-items: center;
    background-color: var(--bg-soft);
    padding: 3px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule);
  }

  @media (min-width: 900px) {
    .track-switcher {
      display: flex;
    }
  }

  .track-switcher__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .track-switcher__btn:hover {
    color: var(--ink);
  }

  .track-switcher__btn.is-active {
    background-color: var(--surface);
    color: var(--accent);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--rule-accent);
  }

  /* Nav List */
  .site-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .site-nav {
      display: block;
    }
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .site-nav__link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-nav__link:hover {
    color: var(--accent);
  }

  /* Header Actions */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .lang-switch {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .lang-switch:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--bg-soft);
  }

  .header-cta {
    display: none;
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 36px;
    height: 36px;
    padding: 9px 7px;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--ink);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    background-color: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding-block: 1.5rem 2rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-track-switcher {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .mobile-track-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.5rem;
    border-radius: var(--radius-md);
    background-color: var(--bg-soft);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--rule);
  }

  .mobile-track-btn.is-active {
    background-color: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .mobile-nav__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav__link {
    display: block;
    padding: 0.65rem 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .mobile-drawer__footer {
    margin-top: 1.5rem;
  }

  .w-full {
    width: 100%;
  }
</style>

<script>
  // Mobile drawer toggle script
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-drawer]');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.hidden = isExpanded;
    });

    // Close when clicking a link
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.hidden = true;
      });
    });
  }
</script>
