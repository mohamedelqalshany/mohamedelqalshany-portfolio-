---
import { getT } from '../../lib/i18n.js';

interface Props {
  locale?: 'ar' | 'en';
}

const { locale = 'ar' } = Astro.props;
const t = getT(locale);
const isAr = locale === 'ar';

const steps = [
  { num: '01', title: t.step1Title, desc: t.step1Desc, icon: '🔍' },
  { num: '02', title: t.step2Title, desc: t.step2Desc, icon: '📝' },
  { num: '03', title: t.step3Title, desc: t.step3Desc, icon: '🎬' },
  { num: '04', title: t.step4Title, desc: t.step4Desc, icon: '🎧' },
  { num: '05', title: t.step5Title, desc: t.step5Desc, icon: '🚀' }
];
---

<section class="section" id="workflow">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t.workflowEyebrow}
      </p>
      <h2 class="section-head__title">
        {t.workflowTitle}
      </h2>
      <p class="section-head__lede">
        {isAr 
          ? 'منهجية معملية مدروسة: نبدأ بفهم العميل ومخاوفه، ونصيغ رسالة تخاطب عقله وعاطفته، ونخرجها بأعلى جودة.' 
          : 'A disciplined production funnel engineered to minimize guesswork and maximize conversion.'}
      </p>
    </div>

    <div class="workflow-timeline">
      {steps.map(step => (
        <div class="workflow-step-card">
          <div class="step-badge">
            <span class="step-icon">{step.icon}</span>
            <span class="step-num font-artistic">{step.num}</span>
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .workflow-timeline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .workflow-timeline {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .workflow-timeline {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.25rem;
    }
  }

  .workflow-step-card {
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .workflow-step-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .step-badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .step-icon {
    font-size: 1.6rem;
  }

  .step-num {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent);
  }

  .step-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .step-desc {
    font-size: 0.86rem;
    color: var(--ink-secondary);
    line-height: 1.55;
    margin: 0;
  }
</style>
