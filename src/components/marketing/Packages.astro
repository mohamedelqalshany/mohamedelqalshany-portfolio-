---
import { getT } from '../../lib/i18n.js';
import mktData from '../../data/marketing.json';
import siteData from '../../data/site.json';

interface Props {
  locale?: 'ar' | 'en';
}

const { locale = 'ar' } = Astro.props;
const t = getT(locale);
const isAr = locale === 'ar';
---

<section class="section section--soft" id="packages">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {isAr ? 'الباقات ونماذج التعاون' : 'Packages & Collaboration'}
      </p>
      <h2 class="section-head__title">
        {isAr ? 'باقات إنتاج واضحة ومحددة النتائج' : 'Defined Deliverables & Clear Timelines'}
      </h2>
      <p class="section-head__lede">
        {isAr 
          ? 'بدون وعود وهمية أو تكاليف مبهمة. حلول عملية تمنح علامتك التجارية محتوى احترافي جاهز للتحويل والمبيعات.' 
          : 'Zero vague promises. Practical production sprints built to drive measurable revenue for your brand.'}
      </p>
    </div>

    <!-- 3 Pricing/Package Cards -->
    <div class="packages-grid">
      {mktData.packages.map((pkg, idx) => (
        <div class:list={['card', 'pkg-card', { 'pkg-card--featured': idx === 0 }]}>
          <div class="pkg-card__head">
            <span class="badge badge--forest">{isAr ? pkg.badgeAr : pkg.badgeEn}</span>
            <h3 class="pkg-card__title">{isAr ? pkg.titleAr : pkg.titleEn}</h3>
            <p class="pkg-card__tagline">{isAr ? pkg.taglineAr : pkg.taglineEn}</p>
          </div>

          <div class="pkg-card__deliverables">
            <span class="deliv-heading">{isAr ? 'ما تتضمنه الباقة:' : 'What is Included:'}</span>
            <ul class="deliv-list">
              {(isAr ? pkg.deliverablesAr : pkg.deliverablesEn).map(item => (
                <li>
                  <span class="check-icon" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pkg-card__meta">
            <div class="meta-item">
              <span class="meta-label">{isAr ? 'مدة التنفيذ' : 'Timeline'}</span>
              <span class="meta-val font-artistic">{isAr ? pkg.timelineAr : pkg.timelineEn}</span>
            </div>
          </div>

          <div class="pkg-card__footer">
            <a 
              href={`${siteData.whatsappUrl}&text=${encodeURIComponent(isAr ? `مرحباً أستاذ محمد، أود الاستفسار عن ${pkg.titleAr}` : `Hello Mohamed, I am inquiring about ${pkg.titleEn}`)}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class:list={['btn', idx === 0 ? 'btn--primary' : 'btn--secondary', 'w-full']}
            >
              <span>{isAr ? pkg.actionTextAr : pkg.actionTextEn}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Comparison: One-Man Crew vs Traditional Agency -->
    <div class="comparison-section">
      <div class="comparison-head">
        <h3 class="comparison-title">
          {isAr ? (
            <>لماذا تختار أسلوب الـ <span dir="ltr" class="inline-en">(One-Man Crew)</span> مقارنة بالوكالات التقليدية؟</>
          ) : (
            'Why Choose the One-Man Crew Model over Traditional Agencies?'
          )}
        </h3>
        <p class="comparison-sub">
          {isAr 
            ? 'مقارنة شفافة توضح فارق السرعة والتكلفة وجودة المخرج النهائي.' 
            : 'A transparent comparison highlighting speed, cost-efficiency, and creative unity.'}
        </p>
      </div>

      <!-- Desktop Table (>= 768px) -->
      <div class="table-container desktop-only">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>{isAr ? 'وجه المقارنة' : 'Evaluation Aspect'}</th>
              <th class="col-traditional">
                {isAr ? 'الوكالة التقليدية' : 'Traditional Agency'} 
                <span dir="ltr" class="th-sub">(Agency)</span>
              </th>
              <th class="col-qalshany">
                {isAr ? 'محمد القلشاني' : 'Mohamed El-Qalshany'} 
                <span dir="ltr" class="th-sub">(One-Man Crew) ★</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {mktData.comparison.map(row => (
              <tr>
                <td class="cell-aspect">
                  <strong>{isAr ? row.aspectAr : row.aspectEn}</strong>
                </td>
                <td class="cell-traditional">
                  {isAr ? row.traditionalAr : row.traditionalEn}
                </td>
                <td class="cell-qalshany">
                  <span>{isAr ? row.qalshanyAr : row.qalshanyEn}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Comparison Cards (< 768px) -->
      <div class="comparison-mobile-stack mobile-only">
        {mktData.comparison.map((row, idx) => (
          <div class="cmp-mobile-card">
            <div class="cmp-mobile-card__header">
              <span class="cmp-aspect-index font-artistic">0{idx + 1}</span>
              <h4 class="cmp-aspect-title">{isAr ? row.aspectAr : row.aspectEn}</h4>
            </div>

            <div class="cmp-mobile-card__row cmp-mobile-card__row--qalshany">
              <div class="cmp-row-label">
                <span class="badge badge--forest">{isAr ? 'محمد القلشاني' : 'Mohamed El-Qalshany'}</span>
                <span class="cmp-sub-tag" dir="ltr">(One-Man Crew) ★</span>
              </div>
              <p class="cmp-row-val cmp-row-val--highlight">
                {isAr ? row.qalshanyAr : row.qalshanyEn}
              </p>
            </div>

            <div class="cmp-mobile-card__row cmp-mobile-card__row--traditional">
              <div class="cmp-row-label">
                <span class="cmp-agency-tag">{isAr ? 'الوكالة التقليدية' : 'Traditional Agency'}</span>
                <span class="cmp-sub-tag" dir="ltr">(Agency)</span>
              </div>
              <p class="cmp-row-val">
                {isAr ? row.traditionalAr : row.traditionalEn}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .packages-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 5rem;
  }

  @media (min-width: 992px) {
    .packages-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pkg-card {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    position: relative;
  }

  .pkg-card--featured {
    border-color: var(--accent);
    box-shadow: var(--shadow-md), 0 0 20px var(--accent-faint);
  }

  .pkg-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .pkg-card__title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .pkg-card__tagline {
    font-size: 0.92rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .pkg-card__deliverables {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .deliv-heading {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }

  .deliv-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .deliv-list li {
    font-size: 0.88rem;
    color: var(--ink-secondary);
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    line-height: 1.5;
  }

  .check-icon {
    color: var(--brand-link);
    font-weight: 700;
    flex-shrink: 0;
  }

  .pkg-card__meta {
    margin-bottom: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .meta-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .meta-label {
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .meta-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent);
  }

  .w-full {
    width: 100%;
  }

  /* Comparison Section */
  .comparison-section {
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    padding: 3rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 767px) {
    .comparison-section {
      padding: 1.75rem 1rem;
    }
  }

  .comparison-head {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .comparison-title {
    font-size: 1.45rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .inline-en {
    display: inline-block;
    direction: ltr;
    font-weight: 700;
  }

  .th-sub {
    display: block;
    font-size: 0.75rem;
    font-weight: normal;
    margin-top: 0.25rem;
    opacity: 0.85;
  }

  .comparison-sub {
    font-size: 0.95rem;
    color: var(--ink-secondary);
  }

  /* Responsive Display Toggles */
  .desktop-only {
    display: none;
  }

  .mobile-only {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .desktop-only {
      display: block;
    }
    .mobile-only {
      display: none;
    }
  }

  /* Desktop Table */
  .table-container {
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    text-align: right;
  }

  :global([dir="ltr"]) .comparison-table th,
  :global([dir="ltr"]) .comparison-table td {
    text-align: left;
  }

  .comparison-table th {
    background-color: var(--bg-soft);
    font-weight: 700;
    color: var(--ink);
  }

  .col-qalshany {
    background-color: var(--accent-faint) !important;
    color: var(--accent) !important;
  }

  .cell-qalshany {
    background-color: var(--accent-faint);
    font-weight: 600;
    color: var(--ink);
  }

  /* Mobile Comparison Cards */
  .cmp-mobile-card {
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 1.15rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    box-shadow: var(--shadow-sm);
  }

  .cmp-mobile-card__header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--rule);
  }

  .cmp-aspect-index {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--brand-link);
    line-height: 1;
  }

  .cmp-aspect-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: 1.35;
  }

  .cmp-mobile-card__row {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .cmp-mobile-card__row--qalshany {
    background-color: var(--accent-faint);
    border: 1.5px solid var(--accent);
  }

  .cmp-mobile-card__row--traditional {
    background-color: var(--bg-soft);
    border: 1px dashed var(--rule-strong);
  }

  .cmp-row-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cmp-sub-tag {
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .cmp-agency-tag {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-secondary);
    background: rgba(0, 0, 0, 0.05);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
  }

  html[data-theme='dark'] .cmp-agency-tag {
    background: rgba(255, 255, 255, 0.08);
  }

  .cmp-row-val {
    font-size: 0.92rem;
    color: var(--ink);
    margin: 0;
    line-height: 1.55;
  }

  .cmp-row-val--highlight {
    font-weight: 600;
    color: var(--ink);
  }
</style>
