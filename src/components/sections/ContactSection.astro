---
import { getT } from '../../lib/i18n.js';
import siteData from '../../data/site.json';

interface Props {
  locale?: 'ar' | 'en';
}

const { locale = 'ar' } = Astro.props;
const t = getT(locale);
const isAr = locale === 'ar';
---

<section class="section contact-section" id="contact">
  <div class="ambient-glow ambient-glow--terracotta" style="bottom: 5%; right: 10%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow--forest" style="top: 10%; left: 5%;" aria-hidden="true"></div>

  <div class="container contact-container">
    <div class="section-head section-head--center">
      <p class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t.contactEyebrow}
      </p>
      <h2 class="section-head__title">
        {t.contactTitle}
      </h2>
      <p class="section-head__lede">
        {t.contactSub}
      </p>
    </div>

    <!-- Quick Action Channels -->
    <div class="contact-channels-grid">
      <!-- WhatsApp Card -->
      <a href={siteData.whatsappUrl} target="_blank" rel="noopener noreferrer" class="channel-card channel-card--whatsapp">
        <div class="channel-icon">💬</div>
        <div class="channel-info">
          <span class="channel-label">{t.contactWhatsApp}</span>
          <span class="channel-val">{isAr ? 'بدء محادثة فورية عبر واتساب' : 'Start Instant WhatsApp Chat'}</span>
        </div>
        <span class="channel-arrow" aria-hidden="true">{isAr ? '←' : '→'}</span>
      </a>

      <!-- Direct Call Card -->
      <a href={`tel:${siteData.phoneIntl}`} class="channel-card channel-card--phone">
        <div class="channel-icon">📱</div>
        <div class="channel-info">
          <span class="channel-label">{t.contactPhone}</span>
          <span class="channel-val">{isAr ? 'اضغط للاتصال المباشر' : 'Click to Call Directly'}</span>
        </div>
        <span class="channel-arrow" aria-hidden="true">{isAr ? '←' : '→'}</span>
      </a>

      <!-- Email Card -->
      <a href={`mailto:${siteData.email}`} class="channel-card channel-card--email">
        <div class="channel-icon">✉️</div>
        <div class="channel-info">
          <span class="channel-label">{t.contactEmail}</span>
          <span class="channel-val">{isAr ? 'إرسال بريد إلكتروني مباشر' : 'Send Direct Email Message'}</span>
        </div>
        <span class="channel-arrow" aria-hidden="true">{isAr ? '←' : '→'}</span>
      </a>
    </div>

    <!-- Interactive Project Inquiry Form -->
    <div class="card inquiry-card">
      <div class="inquiry-card__head">
        <h3 class="inquiry-title">{isAr ? 'أو أرسل تفاصيل مشروعك مباشرةً' : 'Or Send Project Details Directly'}</h3>
        <p class="inquiry-sub">{isAr ? 'سأقوم بالرد عليك خلال أقل من 12 ساعة مع مقترح مالي وجدول زمني محدد.' : 'I will get back to you within 12 hours with a scope and turnaround timeline.'}</p>
      </div>

      <form class="inquiry-form" data-inquiry-form>
        <div class="form-row">
          <div class="form-group">
            <label for="client-name">{isAr ? 'الاسم أو اسم الشركة' : 'Your Name / Company'}</label>
            <input type="text" id="client-name" name="name" required placeholder={isAr ? 'مثال: أحمد عبد الله' : 'e.g. John Doe'} />
          </div>
          <div class="form-group">
            <label for="client-phone">{isAr ? 'رقم الهاتف / واتساب' : 'Phone / WhatsApp'}</label>
            <input type="tel" id="client-phone" name="phone" required placeholder={isAr ? '010XXXXXXXX' : '+20 10...'} dir="ltr" />
          </div>
        </div>

        <div class="form-group">
          <label for="project-type">{isAr ? 'نوع المشروع المطلوب' : 'Project Scope'}</label>
          <select id="project-type" name="type">
            <option value="vo">{isAr ? '🎙️ تعليق صوتي (إعلانات / وثائقي / تمثيل / IVR)' : '🎙️ Voice Over Recording'}</option>
            <option value="reels">{isAr ? '🎬 إنتاج ريلز وفيديوهات قصيرة (One-Man Crew)' : '🎬 Short Video Reels Sprint'}</option>
            <option value="campaign">{isAr ? '🚀 إعلان تجاري ترويجي متكامل (كتابة + تصوير + صوت)' : '🚀 Full Commercial Ad Campaign'}</option>
            <option value="retainer">{isAr ? '💼 شراكة إنتاج شهرية مستمرة (Retainer)' : '💼 Monthly Content Partnership'}</option>
          </select>
        </div>

        <div class="form-group">
          <label for="client-message">{isAr ? 'نبذة عن المشروع والنص أو الفكرة' : 'Project Summary / Script'}</label>
          <textarea id="client-message" name="message" rows="4" placeholder={isAr ? 'اكتب تفاصيل المشروع، الميعاد المطلوب للتسليم، أو رابط المسودة...' : 'Briefly describe your project, timeline, or paste your script...'}></textarea>
        </div>

        <button type="submit" class="btn btn--primary btn--lg w-full">
          <span>{isAr ? 'إرسال عبر واتساب فوراً' : 'Send via WhatsApp Instantly'}</span>
          <span aria-hidden="true">🚀</span>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
  }

  .contact-container {
    position: relative;
    z-index: 1;
  }

  .contact-channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 980px;
    margin-inline: auto;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .contact-channels-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .channel-card {
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .channel-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .channel-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .channel-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }

  .channel-val {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    word-break: break-word;
  }

  .channel-arrow {
    font-size: 1.2rem;
    color: var(--ink-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .channel-card:hover .channel-arrow {
    color: var(--accent);
    transform: translateX(-4px);
  }

  :global([dir="ltr"]) .channel-card:hover .channel-arrow {
    transform: translateX(4px);
  }

  /* Inquiry Form */
  .inquiry-card {
    max-width: 780px;
    margin-inline: auto;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-xl);
  }

  @media (min-width: 768px) {
    .inquiry-card {
      padding: 3rem 2.5rem;
    }
  }

  .inquiry-card__head {
    margin-bottom: 2rem;
    text-align: center;
  }

  .inquiry-title {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .inquiry-sub {
    font-size: 0.92rem;
    color: var(--ink-secondary);
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-group label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background-color: var(--bg);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-faint);
  }

  .w-full {
    width: 100%;
  }
</style>

<script>
  function setupInquiryForm() {
    const form = document.querySelector('[data-inquiry-form]');
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (form.querySelector('#client-name') as HTMLInputElement)?.value || '';
      const phone = (form.querySelector('#client-phone') as HTMLInputElement)?.value || '';
      const type = (form.querySelector('#project-type') as HTMLSelectElement)?.selectedOptions[0]?.text || '';
      const msg = (form.querySelector('#client-message') as HTMLTextAreaElement)?.value || '';

      const text = `مرحباً أستاذ محمد، لدي طلب مشروع جديد:\n\n👤 الاسم: ${name}\n📱 الهاتف: ${phone}\n🎯 نوع الخدمة: ${type}\n📝 تفاصيل المشروع:\n${msg}`;
      const url = `https://wa.me/201017038432?text=${encodeURIComponent(text)}`;
      window.open(url, '_blank');
    });
  }

  document.addEventListener('DOMContentLoaded', setupInquiryForm);
</script>
