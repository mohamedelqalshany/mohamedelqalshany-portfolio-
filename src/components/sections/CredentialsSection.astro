---
import { getT } from '../../lib/i18n.js';

interface Props {
  locale?: 'ar' | 'en';
}

const { locale = 'ar' } = Astro.props;
const t = getT(locale);
const isAr = locale === 'ar';
---

<section class="section section--soft" id="credentials">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {t.credEyebrow}
      </p>
      <h2 class="section-head__title">
        {t.credTitle}
      </h2>
      <p class="section-head__lede">
        {isAr 
          ? 'تأهيل أكاديمي وعملي معتمد يجمع بين الرؤية الاستراتيجية للتسويق والتمكن الاحترافي من الأداء الصوتي.' 
          : 'Accredited training combining strategic marketing acumen with broadcast vocal mastery.'}
      </p>
    </div>

    <div class="cred-grid">
      <!-- Credential 1 -->
      <div class="card cred-card">
        <div class="cred-card__year font-artistic">2026</div>
        <div class="cred-card__body">
          <span class="badge badge--forest">{isAr ? 'اعتماد وزاري رئاسي' : 'Presidential Track'}</span>
          <h3 class="cred-card__title">{t.cred1Title}</h3>
          <p class="cred-card__sub">{t.cred1Sub}</p>
        </div>
      </div>

      <!-- Credential 2 -->
      <div class="card cred-card">
        <div class="cred-card__year font-artistic">2019</div>
        <div class="cred-card__body">
          <span class="badge badge--secondary">{isAr ? 'أكاديمية بحرية معتمدة' : 'Accredited Academy'}</span>
          <h3 class="cred-card__title">{t.cred2Title}</h3>
          <p class="cred-card__sub">{t.cred2Sub}</p>
        </div>
      </div>

      <!-- Credential 3 -->
      <div class="card cred-card">
        <div class="cred-card__year font-artistic">VO</div>
        <div class="cred-card__body">
          <span class="badge badge--forest">{isAr ? 'تطوير مستمر' : 'Continuous Craft'}</span>
          <h3 class="cred-card__title">{t.cred3Title}</h3>
          <p class="cred-card__sub">{t.cred3Sub}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cred-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 980px;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .cred-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .cred-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.75rem;
    border-radius: var(--radius-xl);
  }

  .cred-card__year {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .cred-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cred-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
  }

  .cred-card__sub {
    font-size: 0.88rem;
    color: var(--ink-secondary);
    line-height: 1.55;
    margin: 0;
  }
</style>
