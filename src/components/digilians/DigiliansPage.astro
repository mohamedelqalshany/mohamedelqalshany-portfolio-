---
import siteData from '../../data/site.json';

interface Props {
  locale?: 'ar' | 'en';
}

const { locale = 'ar' } = Astro.props;
const isAr = locale === 'ar';

// Data & Assets
const profilePhoto = '/images/digilians-profile.jpg';
const profilePhotoDrive = 'https://drive.google.com/file/d/1IMG_Bmy22PnZTK1JSNwc5aNj1zxc7KHp/view?usp=drive_link';

const fullName = 'Mohamed Mohamed Mohamed El-Qalshany';
const fullNameAr = 'محمد محمد محمد القلشاني';

const cvPdf = '/Mohamed_El_Qalshany_CV.pdf';
const cvDrive = 'https://drive.google.com/file/d/19AdgZsfuHLZW6THy_iK1pclFAXaMpgOx/view?usp=drive_link';

const linkedInUrl = 'https://www.linkedin.com/in/mohamed-el-qalshany/';

const infographicImg = '/images/infographic.png';
const infographicDrive = 'https://drive.google.com/file/d/1QKdIMm0JOaS3a7V74cTn67M_7RYbL1kQ/view?usp=drive_link';

const voTrackHref = isAr ? '/vo' : '/en/vo';
const mktTrackHref = isAr ? '/marketing' : '/en/marketing';
---

<div class="digilians-page" id="profile">
  <!-- Decorative Ambient Glows -->
  <div class="ambient-glow ambient-glow--top" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow--bottom" aria-hidden="true"></div>

  <div class="container digilians-container">
    
    <!-- Hero Profile Section -->
    <header class="digilians-hero">
      <!-- Digilians Tag Badge -->
      <div class="hero-badge-wrap">
        <span class="digilians-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>{isAr ? 'مبادرة ديجيليانز 2026 · Digilians Initiative' : 'Digilians Initiative · 2026 Edition'}</span>
        </span>
      </div>

      <!-- Profile Avatar Container -->
      <div class="avatar-container">
        <div class="avatar-ring">
          <img 
            src={profilePhoto} 
            alt={fullName}
            class="avatar-img"
            width="220"
            height="220"
            loading="eager"
            decoding="async"
          />
        </div>
        <!-- Live Status Pill -->
        <div class="avatar-status-pill" title={isAr ? "متاح للتوظيف والفرص الاستراتيجية" : "Available for opportunities"}>
          <span class="status-pulse" aria-hidden="true"></span>
          <span>{isAr ? 'متاح للفرص والمشاريع' : 'Open for Opportunities'}</span>
        </div>
      </div>

      <!-- Identity & Headlines -->
      <div class="hero-identity">
        <h1 class="hero-name">
          {fullName}
        </h1>
        <p class="hero-name-arabic" aria-label="الاسم بالعربية">
          {fullNameAr}
        </p>

        <p class="hero-title">
          {isAr 
            ? 'مسوّق رقمي واستراتيجي محتوى · مؤدي صوتي إعلاني · صانع وسائط متكامل' 
            : 'Digital Marketing Strategist · Voice Over Artist · Creative Content Producer'}
        </p>

        <p class="hero-bio">
          {isAr
            ? 'دمج فريد بين عمق الأداء الصوتي الإعلاني، الاستراتيجية التسويقية البيعية، والتنفيذ المرئي السينمائي المتكامل (One-Man Crew). شغوف بتحويل القصص إلى أرقام ونتائج حقيقية على الأرض.'
            : 'A unique fusion of persuasive commercial voice delivery, data-driven marketing strategy, and end-to-end cinematic media production (One-Man Crew). Transforming creative stories into measurable business outcomes.'}
        </p>

        <!-- Quick Tags -->
        <div class="competency-pills">
          <span class="pill">📈 {isAr ? 'استراتيجيات التسويق' : 'Marketing Strategy'}</span>
          <span class="pill">🎙️ {isAr ? 'تعليق صوتي إعلاني' : 'Commercial Voice Over'}</span>
          <span class="pill">✍️ {isAr ? 'كتابة الإعلانات وهوكات البيع' : 'Copywriting & Hooks'}</span>
          <span class="pill">🎬 {isAr ? 'إنتاج ومونتاج مرئي' : 'Media Production'}</span>
          <span class="pill">🚀 Digilians 2026</span>
        </div>
      </div>
    </header>

    <!-- Main Highlights & Key Assets Grid (CV, LinkedIn, Infographic) -->
    <section class="assets-section" aria-label={isAr ? "الملفات والروابط الرئيسية" : "Key Resources & Links"}>
      <div class="section-heading">
        <h2 class="section-title">
          {isAr ? 'الوثائق والروابط المباشرة' : 'Official Credentials & Direct Links'}
        </h2>
        <p class="section-subtitle">
          {isAr ? 'اضغط لعرض السيرة الذاتية، حساب لينكد إن، والإنفوجرافيك الشامل' : 'Direct access to CV, verified LinkedIn profile, and comprehensive infographic'}
        </p>
      </div>

      <div class="assets-grid">
        
        <!-- CARD 1: VIEW CV -->
        <article class="asset-card asset-card--cv" id="cv">
          <div class="asset-card__header">
            <div class="asset-icon asset-icon--cv" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <line x1="10" y1="9" x2="8" y2="9"></line>
              </svg>
            </div>
            <span class="asset-tag">{isAr ? 'وثيقة PDF معتمدة' : 'Verified PDF'}</span>
          </div>

          <div class="asset-card__body">
            <h3 class="asset-title">{isAr ? 'السيرة الذاتية' : 'Curriculum Vitae (CV)'}</h3>
            <p class="asset-desc">
              {isAr 
                ? 'استعرض تفاصيل الخبرات العملية، المسار الأكاديمي، الشهادات الاحترافية، والمهارات التقنية في التسويق والأداء الصوتي.'
                : 'Full professional summary including work history, academic background, industry certifications, and technical proficiencies.'}
            </p>

            <div class="asset-features">
              <span>✓ {isAr ? 'أحدث تحديث 2026' : 'Updated for 2026'}</span>
              <span>✓ {isAr ? 'جاهز للتحميل والطباعة' : 'Print & ATS Friendly'}</span>
            </div>
          </div>

          <div class="asset-card__actions">
            <a 
              href={cvPdf} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn--primary w-full"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              <span>{isAr ? 'عرض السيرة الذاتية (PDF)' : 'View CV (PDF)'}</span>
            </a>

            <div class="btn-group-row">
              <a 
                href={cvDrive} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn--secondary"
                title={isAr ? "فتح على جوجل درايف" : "Open in Google Drive"}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                <span>Google Drive</span>
              </a>

              <a 
                href={cvPdf} 
                download="Mohamed_El_Qalshany_CV.pdf"
                class="btn btn--secondary"
                title={isAr ? "تحميل مباشر" : "Direct Download"}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>{isAr ? 'تحميل' : 'Download'}</span>
              </a>
            </div>
          </div>
        </article>

        <!-- CARD 2: LINKEDIN PROFILE -->
        <article class="asset-card asset-card--linkedin" id="linkedin">
          <div class="asset-card__header">
            <div class="asset-icon asset-icon--linkedin" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <span class="asset-tag asset-tag--linkedin">{isAr ? 'الملف المهني' : 'Verified Profile'}</span>
          </div>

          <div class="asset-card__body">
            <h3 class="asset-title">{isAr ? 'ملف لينكد إن' : 'LinkedIn Profile'}</h3>
            <p class="asset-desc">
              {isAr
                ? 'تواصل مباشرة عبر شبكة لينكد إن المهنية للاطلاع على التوصيات، الأنشطة، والشبكة الاحترافية لمحمد القلشاني.'
                : 'Connect on LinkedIn to explore endorsements, recommendations, professional updates, and mutual connections.'}
            </p>

            <div class="asset-features">
              <span>💼 /in/mohamed-el-qalshany</span>
              <span>⚡ {isAr ? 'استجابة سريعة' : 'Quick Response'}</span>
            </div>
          </div>

          <div class="asset-card__actions">
            <a 
              href={linkedInUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn--linkedin w-full"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>{isAr ? 'زيارة الملف الشخصي على LinkedIn' : 'Visit LinkedIn Profile'}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </article>

        <!-- CARD 3: VIEW INFOGRAPHIC -->
        <article class="asset-card asset-card--infographic" id="infographic">
          <div class="asset-card__header">
            <div class="asset-icon asset-icon--infographic" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
              </svg>
            </div>
            <span class="asset-tag">{isAr ? 'عرض بياني عالي الدقة' : 'Visual Infographic'}</span>
          </div>

          <div class="asset-card__body">
            <h3 class="asset-title">{isAr ? 'الإنفوجرافيك الاحترافي' : 'Professional Infographic'}</h3>
            <p class="asset-desc">
              {isAr
                ? 'ملخص بصري تفاعلي يبرز ركائز الخبرة، منهجية العمل، نماذج المشاريع، والقدرات الإنتاجية والتسويقية.'
                : 'A visual summary presenting key capability pillars, strategic workflows, production methodology, and project outcomes.'}
            </p>

            <!-- Infographic Interactive Thumbnail -->
            <div class="infographic-thumbnail-wrapper" data-open-modal="infographic-modal">
              <img 
                src={infographicImg} 
                alt="Infographic Preview" 
                class="infographic-thumb-img"
                loading="lazy"
              />
              <div class="thumb-overlay">
                <span class="thumb-pill">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  <span>{isAr ? 'اضغط للتكبير والعرض الكامل' : 'Click to Expand'}</span>
                </span>
              </div>
            </div>
          </div>

          <div class="asset-card__actions">
            <button 
              type="button" 
              class="btn btn--primary w-full"
              data-open-modal="infographic-modal"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              <span>{isAr ? 'عرض الإنفوجرافيك (View Infographic)' : 'View Infographic'}</span>
            </button>

            <div class="btn-group-row">
              <a 
                href={infographicDrive} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn--secondary"
                title={isAr ? "فتح على جوجل درايف" : "Open on Google Drive"}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                <span>Google Drive</span>
              </a>

              <a 
                href={infographicImg} 
                download="Mohamed_El_Qalshany_Infographic.png"
                class="btn btn--secondary"
                title={isAr ? "تحميل الصورة عالية الدقة" : "Download High-Res Image"}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>{isAr ? 'تحميل الصورة' : 'Download'}</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- Additional Track Exploration: Voice Over & Marketing -->
    <section class="tracks-section" aria-label={isAr ? "استكشف باقي أعمال محمد" : "Explore Mohamed's Work"}>
      <div class="section-heading">
        <h2 class="section-title">
          {isAr ? 'استكشف المعرض والمسارات الكاملة' : 'Explore Full Portfolio & Tracks'}
        </h2>
        <p class="section-subtitle">
          {isAr ? 'استمع لعينات التعليق الصوتي أو شاهد نماذج الحملات والتصوير الإعلاني' : 'Listen to studio voice samples or explore end-to-end marketing case studies'}
        </p>
      </div>

      <div class="tracks-grid">
        <a href={voTrackHref} class="track-card-preview">
          <div class="track-card-preview__icon">🎙️</div>
          <div class="track-card-preview__content">
            <span class="track-tag">{isAr ? 'مسار الصوت' : 'Voice Over'}</span>
            <h3 class="track-title">{isAr ? 'معرض التعليق الصوتي الاحترافي' : 'Professional Voice Over Hub'}</h3>
            <p class="track-desc">
              {isAr ? 'أكثر من 20 عينة صوتية: إعلانات، تمثيل، وثائقيات، وكتب صوتية مع مشغل مدمج عالي النقاء.' : '20+ studio voice samples: Commercials, storytelling, documentaries, with built-in audio players.'}
            </p>
            <span class="track-link-cta">{isAr ? 'استمع لعينات الصوت ←' : 'Listen to Voice Samples →'}</span>
          </div>
        </a>

        <a href={mktTrackHref} class="track-card-preview">
          <div class="track-card-preview__icon">🎬</div>
          <div class="track-card-preview__content">
            <span class="track-tag">{isAr ? 'مسار التسويق' : 'Marketing Engine'}</span>
            <h3 class="track-title">{isAr ? 'منظومة التسويق وصناعة المحتوى' : 'Marketing & Content Production'}</h3>
            <p class="track-desc">
              {isAr ? 'كتابة إعلانية، هوكات بيعية، تصوير سينمائي 4K، وتحليل أداء للحملات الرقمية.' : 'High-converting ad copywriting, 4K production, post-production and campaign strategy.'}
            </p>
            <span class="track-link-cta">{isAr ? 'استكشف خدمات التسويق ←' : 'Explore Marketing Showcase →'}</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Contact & Direct Inquiry Section -->
    <section class="contact-strip" id="contact" aria-label={isAr ? "تواصل مباشر" : "Direct Contact"}>
      <div class="contact-strip__inner">
        <div class="contact-strip__info">
          <span class="badge-mini">{isAr ? 'تواصل فوري' : 'Direct Connect'}</span>
          <h2 class="contact-heading">
            {isAr ? 'هل لديك فرصة أو مشروع تود مناقشته؟' : 'Have an Opportunity or Project to Discuss?'}
          </h2>
          <p class="contact-sub">
            {isAr 
              ? 'متاح لمناقشة الفرص الوظيفية، المشاريع المستقلة، والاستشارات التسويقية والإنتاجية.' 
              : 'Available for full-time opportunities, high-impact freelance projects, and marketing consultations.'}
          </p>
        </div>

        <div class="contact-strip__actions">
          <a 
            href={siteData.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn--whatsapp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.112.551 4.095 1.517 5.823l-1.617 5.91 6.079-1.595c1.668.91 3.57 1.431 5.597 1.431 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>{isAr ? 'محادثة واتساب مباشرة' : 'Chat on WhatsApp'}</span>
          </a>

          <a 
            href={`mailto:${siteData.email}`} 
            class="btn btn--secondary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>{siteData.email}</span>
          </a>

          <a 
            href={`tel:${siteData.phoneIntl}`} 
            class="btn btn--secondary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{siteData.phone}</span>
          </a>
        </div>
      </div>
    </section>

  </div>
</div>

<!-- INFOGRAPHIC MODAL LIGHTBOX -->
