---
interface Props {
  locale?: 'ar' | 'en';
}

const { locale = 'ar' } = Astro.props;

const profilePhoto = '/images/digilians-profile.jpg';
const fullName = 'Mohamed Mohamed Mohamed El-Qalshany';
const jobTitle = 'Digital Marketing Specialist';
const jobSubtitle = 'Digital Arts Track (Nano Degree)';
const cvDrive = 'https://drive.google.com/file/d/19AdgZsfuHLZW6THy_iK1pclFAXaMpgOx/view?usp=drive_link';
const linkedInUrl = 'https://www.linkedin.com/in/mohamed-el-qalshany/';
const infographicDrive = 'https://drive.google.com/file/d/1QKdIMm0JOaS3a7V74cTn67M_7RYbL1kQ/view?usp=drive_link';
---

<div class="digi-page">
  <!-- Profile Photo -->
  <div class="digi-avatar-wrap">
    <img
      src={profilePhoto}
      alt={fullName}
      class="digi-avatar"
      width="180"
      height="180"
      loading="eager"
    />
  </div>

  <!-- Name Badge -->
  <div class="digi-name-badge">
    
    <span class="digi-name-text">{fullName}</span>
  </div>

  <!-- Title Badge -->
  <div class="digi-title-badge">
    
    <div class="digi-title-text">
      <strong>{jobTitle}</strong>
      <span>{jobSubtitle}</span>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="digi-actions">
    <a href={cvDrive} target="_blank" rel="noopener noreferrer" class="digi-btn">
      <span>View my CV</span>
      <span>📄</span>
    </a>
    <a href={linkedInUrl} target="_blank" rel="noopener noreferrer" class="digi-btn">
      <span>LinkedIn Profile</span>
      <span>💼</span>
    </a>
    <a href={infographicDrive} target="_blank" rel="noopener noreferrer" class="digi-btn">
      <span>View Infographic</span>
      <span>📊</span>
    </a>
  </div>
</div>

<style>
  .digi-page {
    min-height: 100vh;
    background-color: #f0f7ee;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 2rem 1.25rem;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  /* Avatar */
  .digi-avatar-wrap {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 5px solid #1a4731;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(26, 71, 49, 0.18);
    flex-shrink: 0;
  }

  .digi-avatar {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Name Badge */
  .digi-name-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #1a4731, #2d6a4f);
    color: #d4af5a;
    font-size: 1.05rem;
    font-weight: 700;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(26, 71, 49, 0.35), inset 0 2px 4px rgba(255,255,255,0.2);
    text-align: center;
    max-width: 420px;
    width: 100%;
    justify-content: center;
    transform: perspective(600px) rotateX(5deg);
  }

  .digi-name-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .digi-name-text {
    letter-spacing: 0.01em;
  }

  /* Title Badge */
  .digi-title-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #2d6a4f, #40916c);
    color: #fff;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(26, 71, 49, 0.35), inset 0 2px 4px rgba(255,255,255,0.2);
    max-width: 380px;
    width: 100%;
    justify-content: center;
    transform: perspective(600px) rotateX(5deg);
  }

  .digi-title-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .digi-title-text {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .digi-title-text strong {
    color: #d4af5a;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .digi-title-text span {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.1rem;
  }

  /* Action Buttons */
  .digi-actions {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
    max-width: 320px;
    margin-top: 0.5rem;
  }

  .digi-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #1a4731 0%, #2d6a4f 100%);
    color: #d4af5a;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(26, 71, 49, 0.22);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    letter-spacing: 0.01em;
  }

  .digi-btn:hover {
    background: linear-gradient(135deg, #1a4731 0%, #2d6a4f 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26, 71, 49, 0.32);
  }

  .digi-btn:active {
    transform: translateY(0);
  }

  /* Mobile */
  @media (max-width: 480px) {
    .digi-name-badge {
      font-size: 0.9rem;
      padding: 0.65rem 1.25rem;
    }

    .digi-title-badge {
      padding: 0.65rem 1.25rem;
    }

    .digi-avatar-wrap {
      width: 140px;
      height: 140px;
    }
  }
</style>
