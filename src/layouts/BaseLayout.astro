---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BackgroundWaves from '../components/common/BackgroundWaves.astro';
import { getT } from '../lib/i18n.js';
import siteData from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  locale?: 'ar' | 'en';
  currentTrack?: 'gateway' | 'vo' | 'marketing';
}

const { 
  locale = 'ar', 
  title, 
  description, 
  currentTrack = 'gateway' 
} = Astro.props;

const t = getT(locale);
const isAr = locale === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

const pageTitle = title || (
  currentTrack === 'vo' ? t.siteTitleVO :
  currentTrack === 'marketing' ? t.siteTitleMarketing :
  `${t.siteName} — ${isAr ? 'مؤدي صوتي وتسويق متكامل' : 'Voice Over & Marketing Engine'}`
);

const pageDesc = description || t.siteDesc;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://mohamedelqalshany.com').href;
---

<!DOCTYPE html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Local Font Preloading (Zero Layout Shift / CLS = 0) -->
    <link rel="preload" href="/fonts/readex-pro-arabic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/aref-ruqaa-arabic-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    {!isAr && (
      <>
        <link rel="preload" href="/fonts/readex-pro-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/aref-ruqaa-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%231E3A2B'/><text x='50%' y='55%' dominant-baseline='middle' text-anchor='middle' font-family='sans-serif' font-weight='bold' font-size='42' fill='%23FAEDCD'>MQ</text></svg>" />

    <!-- OpenGraph & Social Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={isAr ? "ar_EG" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": isAr ? siteData.nameAr : siteData.nameEn,
      "url": "https://mohamedelqalshany.com",
      "jobTitle": isAr ? "مؤدي صوتي ومسوّق رقمي" : "Voice Over Artist & Digital Marketer",
      "description": pageDesc,
      "email": siteData.email,
      "telephone": siteData.phoneIntl,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cairo",
        "addressCountry": "EG"
      },
      "knowsLanguage": ["ar", "en"]
    })} />

    <!-- Blocking Inline Theme Init Script (Guarantees Zero FOIT/FOUC) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">{isAr ? 'الانتقال إلى المحتوى الأساسي' : 'Skip to main content'}</a>
    
    <!-- Ambient Living Soundwaves System -->
    <BackgroundWaves />

    <Header locale={locale} currentTrack={currentTrack} />

    <main id="main-content" class="site-main">
      <slot />
    </main>

    {currentTrack !== 'gateway' && <Footer locale={locale} />}
  </body>
</html>

<style>
  .site-main {
    flex: 1 0 auto;
  }
</style>
