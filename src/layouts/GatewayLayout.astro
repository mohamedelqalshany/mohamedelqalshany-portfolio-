---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  locale?: 'ar' | 'en';
}

const { 
  locale = 'ar', 
  title, 
  description 
} = Astro.props;
---

<BaseLayout 
  locale={locale} 
  currentTrack="gateway"
  title={title}
  description={description}
>
  <slot />
</BaseLayout>
